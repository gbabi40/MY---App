
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#244d40">
<title>MY - Mi Gran YO</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,Arial,sans-serif;background:#f4f6f3;color:#25352d}
header{background:#244d40;color:white;padding:30px 20px;text-align:center}
.logo{font-size:48px;font-weight:800;letter-spacing:3px}
header p{margin:5px}
main{max-width:600px;margin:auto;padding:18px}
h2{font-size:20px}
nav{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
button{border:0;border-radius:12px;padding:14px;font-size:15px;cursor:pointer}
nav button{background:white;color:#244d40;font-weight:600}
nav button.active{background:#244d40;color:white}
.card{background:white;border-radius:16px;padding:18px;margin-top:18px;box-shadow:0 2px 12px #0000000a}
input,select,textarea{width:100%;padding:13px;margin:7px 0;border:1px solid #ddd;border-radius:10px;font:inherit}
.primary{background:#244d40;color:white;width:100%;margin-top:10px;font-weight:bold}
.voice{background:#e4eee8;color:#244d40;width:100%}
.item{padding:13px 0;border-bottom:1px solid #eee;display:flex;justify-content:space-between;gap:10px}
.item.done{opacity:.5;text-decoration:line-through}
.small{font-size:13px;color:#69756d}
.actions{display:flex;gap:5px;align-items:start}
.actions button{padding:8px}
footer{text-align:center;color:#888;font-size:12px;padding:25px}
</style>
</head>
<body>
<header>
<div class="logo">MY</div>
<h1>Mi Gran YO</h1>
<p>Tu vida, organizada a tu manera</p>
</header>
<main>
<h2>Mi agenda</h2>
<nav id="menu">
<button data-cat="Todas" class="active">📅 Todo</button>
<button data-cat="Hijos">👨‍👩‍👧‍👦 Hijos</button>
<button data-cat="Trabajo">💼 Trabajo</button>
<button data-cat="Personal">💚 Personal</button>
<button data-cat="Compras">🛒 Compras</button>
</nav>

<section class="card">
<h2>Agregar actividad</h2>
<form id="form">
<input id="actividad" placeholder="¿Qué tenés que hacer?" required>
<button class="voice" type="button" id="voz">🎤 Dictar actividad</button>
<select id="categoria">
<option>Personal</option>
<option>Hijos</option>
<option>Trabajo</option>
<option>Compras</option>
</select>
<select id="subcategoria"></select>
<input id="fecha" type="date" required>
<input id="hora" type="time">
<textarea id="notas" placeholder="Notas adicionales"></textarea>
<button class="primary" type="submit">+ Guardar actividad</button>
</form>
</section>

<section class="card">
<h2>Mis pendientes</h2>
<div id="lista"></div>
</section>
</main>
<footer>MY · Mi Gran YO</footer>
<script>
const opciones={
Personal:["General","Salud","Turnos","Actividad física"],
Hijos:["Santi","Joaco","Inda","Otro"],
Trabajo:["Pampero","Focus","Psico"],
Compras:["Supermercado","Casa","Hijos","Trabajo"]
};
const $=id=>document.getElementById(id);
let tareas=[];
try{tareas=JSON.parse(localStorage.getItem("my_tareas"))||[]}
catch(e){tareas=[]}
let filtro="Todas";
function guardar(){
localStorage.setItem("my_tareas",JSON.stringify(tareas));
render();
}
function subcategorias(){
$("subcategoria").replaceChildren();
opciones[$("categoria").value].forEach(x=>{
const o=document.createElement("option");
o.value=x;o.textContent=x;
$("subcategoria").appendChild(o);
});
}
$("categoria").onchange=subcategorias;
subcategorias();
const hoy=new Date();
const local=new Date(hoy.getTime()-hoy.getTimezoneOffset()*60000);
$("fecha").value=local.toISOString().slice(0,10);
$("form").onsubmit=e=>{
e.preventDefault();
tareas.push({
id:Date.now().toString()+Math.random(),
nombre:$("actividad").value.trim(),
categoria:$("categoria").value,
sub:$("subcategoria").value,
fecha:$("fecha").value,
hora:$("hora").value,
notas:$("notas").value,
hecho:false
});
guardar();
$("actividad").value="";
$("notas").value="";
$("hora").value="";
alert("Actividad guardada en MY");
};
document.querySelectorAll("#menu button").forEach(b=>{
b.onclick=()=>{
filtro=b.dataset.cat;
document.querySelectorAll("#menu button").forEach(x=>x.classList.remove("active"));
b.classList.add("active");
render();
};
});
function render(){
const lista=$("lista");
lista.replaceChildren();
const visibles=tareas.filter(t=>filtro==="Todas"||t.categoria===filtro)
.sort((a,b)=>(a.fecha+a.hora).localeCompare(b.fecha+b.hora));
if(!visibles.length){
const p=document.createElement("p");
p.textContent="Todavía no hay actividades.";
lista.appendChild(p);
return;
}
visibles.forEach(t=>{
const div=document.createElement("div");
div.className="item"+(t.hecho?" done":"");
const info=document.createElement("div");
const titulo=document.createElement("strong");
titulo.textContent=t.nombre;
const detalle=document.createElement("div");
detalle.className="small";
detalle.textContent=t.fecha+" "+(t.hora||"")+" · "+t.categoria+" / "+t.sub;
info.append(titulo,detalle);
if(t.notas){
const nota=document.createElement("div");
nota.className="small";
nota.textContent=t.notas;
info.appendChild(nota);
}
const acciones=document.createElement("div");
acciones.className="actions";
const ok=document.createElement("button");
ok.textContent=t.hecho?"↩":"✓";
ok.onclick=()=>{t.hecho=!t.hecho;guardar()};
const borrar=document.createElement("button");
borrar.textContent="🗑";
borrar.onclick=()=>{
if(confirm("¿Eliminar esta actividad?")){
tareas=tareas.filter(x=>x.id!==t.id);
guardar();
}
};
acciones.append(ok,borrar);
div.append(info,acciones);
lista.appendChild(div);
});
}
$("voz").onclick=()=>{
const Reconocimiento=window.SpeechRecognition||window.webkitSpeechRecognition;
if(!Reconocimiento){
alert("El dictado no está disponible en este navegador. Podés usar el micrófono del teclado del iPhone.");
return;
}
const r=new Reconocimiento();
r.lang="es-AR";
r.onresult=e=>{$("actividad").value=e.results[0][0].transcript};
r.onerror=()=>alert("No se pudo reconocer la voz.");
r.start();
};
render();
</script>
</body>
</html>
